{
  "name": "limpiaraudio-desktop",
  "version": "1.0.0",
  "description": "LimpiarAudio — app de escritorio (lanzador del servidor local + interfaz).",
  "main": "main.js",
  "author": "Cabildo Kankuamo",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "org.cabildokankuamo.limpiaraudio",
    "productName": "LimpiarAudio",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "loading.html", "package.json"],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LimpiarAudio"
    }
  }
}
